# Backend-only secrets. Never prefix these with VITE_ or commit real values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Temporary Stage 0 admission guard. Replace with one-time pairing in Stage 1.
CUE_BOOTSTRAP_SECRET=replace-with-a-long-random-value
CUE_TOKEN_TTL_MINUTES=10
CUE_CORS_ORIGINS=http://localhost:5173

# Browser build configuration (public, not a secret).
VITE_API_BASE_URL=http://localhost:8000

# Semantic interpreter and live transcription (C-lane).
# Production runtime: CUE_PROVIDER=openai (the default). Ollama is a dev-only
# fallback because the shared OpenAI key currently lives on teammate A's
# machine. Ollama does not participate in the M1 release gate.
OPENAI_API_KEY=
CUE_PROVIDER=openai
CUE_MODEL=
DEEPGRAM_API_KEY=
# Dev-only Ollama override; default is http://localhost:11434.
# OLLAMA_URL=http://localhost:11434
