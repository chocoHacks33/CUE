# Backend-only secrets. Never prefix these with VITE_ or commit real values.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# C owns semantic-provider selection. Do not add providers without a team decision.
CUE_PROVIDER=openai
CUE_MODEL=

# Temporary Stage 0 admission guard. Replace with one-time pairing in Stage 1.
CUE_BOOTSTRAP_SECRET=replace-with-a-long-random-value
CUE_TOKEN_TTL_MINUTES=10
CUE_CORS_ORIGINS=http://localhost:5173

# Browser build configuration (public, not a secret).
VITE_API_BASE_URL=http://localhost:8000
