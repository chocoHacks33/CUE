# CUE demo profile — NO SECRETS.
#
# On the demo Mac:
#   1. Copy this file to ../CUE/.env (git-ignored, in the desk worktree).
#   2. Fill in the two secrets below (OPENAI_API_KEY, DEEPGRAM_API_KEY).
#   3. Export CUE_PROFILE=demo before starting the desk or live lane.
#
# scripts/morning_check.py and apps/api will pick this up automatically
# when CUE_PROFILE=demo.

# -- Secrets (fill on the Mac only; never commit values) --------------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# -- Pinned models ----------------------------------------------------
CUE_MODEL=gpt-5-mini-2025-08-07
DEEPGRAM_MODEL=nova-3

# -- Deepgram streaming knobs ----------------------------------------
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
# Bias the streamer toward the guest names we will really say.
DEEPGRAM_KEYTERMS=Sarah,Daniel,Priya,Maya,Alex,Jordan,Kai,Sarah Tan,Daniel Reyes,Priya Shah

# -- Director policy knobs (documented; matches policy/director.py) --
CUE_LIFETIME_S=3.0
MIN_SHOT_S=2.5

# -- Runtime mode -----------------------------------------------------
# ASSIST unless the Stage 7 morning gate reports AUTO. The desk reads
# this default; the operator may still switch modes live via set_mode.
CUE_MODE_DEFAULT=ASSIST
CUE_ROLE_BASED=1
